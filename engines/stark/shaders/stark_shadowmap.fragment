OUTPUT

in float vDepth;

// Pack the linear light-space depth into RGB for 24-bit precision. 16-bit (RG)
// banded once the light frustum grew to fit long shadows climbing walls: each
// quantization step became coarse and the contact-hardening penumbra keys off it,
// so the steps showed as concentric bands. Sampleable DEPTH textures are
// unreliable on this GL 2.1 stack, so depth lives in colour. The receivers decode
// with dot(c, (1, 1/255, 1/65025)).
void main() {
	float d = clamp(vDepth, 0.0, 1.0);
	vec3 enc = fract(d * vec3(1.0, 255.0, 65025.0));
	enc -= enc.yzz * vec3(1.0 / 255.0, 1.0 / 255.0, 0.0);
	outColor = vec4(enc, 1.0);
}

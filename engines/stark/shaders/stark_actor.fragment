in vec2 Texcoord;
in vec3 EyePosition;
in vec3 EyeNormal;

OUTPUT

struct Light {
	vec4 position;
	vec3 direction;
	vec3 color;
	vec4 params;
};

const int lightTypePoint       = 1;
const int lightTypeDirectional = 2;
const int lightTypeSpot        = 4;

const int maxLights = 10;

uniform UBOOL textured;
uniform sampler2D tex;
uniform sampler2D normalTex;
uniform UBOOL hasNormalMap;
uniform UBOOL debugShowNormals;
uniform vec3 color;
uniform Light lights[maxLights];
uniform vec3 ambientColor;

// Tint matching the scene lighting around the character
uniform vec3 ambientTint;

// Atmospheric depth fog. fogDensity == 0 disables it.
uniform vec3 fogColor;
uniform float fogStart;
uniform float fogEnd;
uniform float fogDensity;

// Specular and rim intensities
const float specularStrength = 0.18;
const float specularShininess = 18.0;
const float rimStrength = 0.25;

// Tangent-free normal mapping (Christian Schueler's method): reconstruct
// the tangent frame from screen-space derivatives, so no per-vertex
// tangents are needed - which the 1999 meshes don't have.
vec3 perturbNormal(vec3 N, vec3 eyePos, vec2 uv) {
	vec3 map = texture(normalTex, uv).xyz * 2.0 - 1.0;

	vec3 dp1 = dFdx(eyePos);
	vec3 dp2 = dFdy(eyePos);
	vec2 duv1 = dFdx(uv);
	vec2 duv2 = dFdy(uv);

	vec3 dp2perp = cross(dp2, N);
	vec3 dp1perp = cross(N, dp1);
	vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;
	vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;

	float invmax = inversesqrt(max(dot(T, T), dot(B, B)));
	return normalize(mat3(T * invmax, B * invmax, N) * map);
}

void main() {
	vec4 base = vec4(color, 1.0);
	if (UBOOL_TEST(textured)) {
		base = texture(tex, Texcoord);
	}

	vec3 N = normalize(EyeNormal);
	if (UBOOL_TEST(hasNormalMap)) {
		N = perturbNormal(N, EyePosition, Texcoord);
	}

	if (UBOOL_TEST(debugShowNormals)) {
		// Visualize the surface normal. With normal maps loaded this looks
		// bumpy/detailed; without them it is a smooth gradient.
		outColor = vec4(N * 0.5 + 0.5, 1.0);
		return;
	}

	vec3 V = normalize(-EyePosition);

	vec3 diffuseAcc = ambientColor;
	vec3 specularAcc = vec3(0.0);

	for (int i = 0; i < maxLights; i++) {
		int type = int(lights[i].position.w);

		vec3 L;
		vec3 lightColor;

		if (type == lightTypePoint || type == lightTypeSpot) {
			vec3 toLight = lights[i].position.xyz - EyePosition;
			float dist = length(toLight);
			float attn = clamp((lights[i].params.y - dist)
					/ max(0.001, lights[i].params.y - lights[i].params.x), 0.0, 1.0);
			L = toLight / max(dist, 0.001);
			lightColor = lights[i].color * attn;

			if (type == lightTypeSpot) {
				float cosAngle = max(0.0, dot(L, -lights[i].direction));
				float cone = clamp((cosAngle - lights[i].params.z)
						/ max(0.001, lights[i].params.w - lights[i].params.z), 0.0, 1.0);
				lightColor *= cone;
			}
		} else if (type == lightTypeDirectional) {
			L = -lights[i].direction;
			lightColor = lights[i].color;
		} else {
			continue;
		}

		float incidence = max(0.0, dot(N, L));
		diffuseAcc += lightColor * incidence;

		if (incidence > 0.0) {
			vec3 H = normalize(L + V);
			float highlight = pow(max(dot(N, H), 0.0), specularShininess);
			// Masking by incidence makes highlights fade in smoothly as
			// surfaces turn towards the light, instead of popping at
			// grazing angles while the character animates
			specularAcc += lightColor * highlight * specularStrength * incidence;
		}
	}

	// Soft rim so the character reads against dark backgrounds
	float rim = pow(1.0 - max(dot(N, V), 0.0), 3.0);
	diffuseAcc += ambientColor * rim * rimStrength;

	vec3 lit = base.rgb * clamp(diffuseAcc, 0.0, 1.0) + specularAcc;
	vec3 finalColor = lit * ambientTint;

	// Atmospheric fog: blend toward the scene's horizon color with distance,
	// so characters recede into exterior haze instead of staying crisp
	if (fogDensity > 0.0) {
		float dist = length(EyePosition);
		float f = clamp((dist - fogStart) / max(fogEnd - fogStart, 0.001), 0.0, 1.0);
		finalColor = mix(finalColor, fogColor, clamp(f * fogDensity, 0.0, 1.0));
	}

	outColor = vec4(finalColor, base.a);
}

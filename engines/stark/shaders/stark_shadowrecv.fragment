OUTPUT

in vec3 vWorld;

uniform mat4 lightVP;        // world -> light clip space
uniform sampler2D shadowTex; // depth-in-colour shadow map
uniform float shadowAlpha;   // darkness of the fully-occluded shadow
uniform float shadowBias;    // depth bias to avoid self-shadow acne
uniform vec2 shadowTexel;    // 1.0 / shadow-map size (for PCF)
uniform float shadowSoftness; // PCF spread in texels (1 = crisp, higher = softer)

float occluderDepth(vec2 uv) {
	vec4 c = texture(shadowTex, uv);
	return (c.r * 255.0 * 256.0 + c.g * 255.0) / 65535.0;
}

void main() {
	vec4 lc = lightVP * vec4(vWorld, 1.0);
	vec3 ndc = lc.xyz / lc.w;
	vec2 uv = ndc.xy * 0.5 + 0.5;

	// Outside the shadow map (light frustum) => not shadowed.
	if (uv.x < 0.01 || uv.x > 0.99 || uv.y < 0.01 || uv.y > 0.99) {
		discard;
	}

	float fragDepth = ndc.z * 0.5 + 0.5;

	// Contact hardening (PCSS-lite): a real shadow is crisp where the caster
	// touches the ground and softens with distance from it. First search for
	// blockers over the max penumbra, average their depth, then scale the PCF
	// kernel by the receiver-to-blocker gap so near the feet it is tight and
	// further out it widens.
	vec2 searchStep = shadowTexel * shadowSoftness;
	float blockerSum = 0.0;
	float blockerCount = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			float od = occluderDepth(uv + vec2(float(x), float(y)) * searchStep);
			if (fragDepth - shadowBias > od) {
				blockerSum += od;
				blockerCount += 1.0;
			}
		}
	}
	if (blockerCount < 0.5) {
		discard; // no blocker => fully lit
	}
	float avgBlocker = blockerSum / blockerCount;
	float gap = max(fragDepth - avgBlocker, 0.0);
	float hard = clamp(gap * 8.0, 0.0, 1.0);
	float penumbra = mix(shadowSoftness * 0.6, shadowSoftness * 1.9, hard);

	vec2 stepv = shadowTexel * penumbra;
	float sh = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			float od = occluderDepth(uv + vec2(float(x), float(y)) * stepv);
			sh += (fragDepth - shadowBias > od) ? 1.0 : 0.0;
		}
	}
	sh /= 25.0;

	if (sh <= 0.0) {
		discard;
	}
	outColor = vec4(0.0, 0.0, 0.0, shadowAlpha * sh);
}

OUTPUT

in vec2 vUV;

// Background depth mask (no character; top-origin loaded texture) + its calibrated
// eye-space range. Used to reconstruct the 3D world position of the pre-rendered
// background (floor, walls, furniture) at each pixel, so the shadow drapes over it.
uniform sampler2D bgDepthTex;
uniform float zMin;
uniform float zMax;
uniform vec2 projScale;   // (proj[0][0], proj[1][1]) - eye-space x/y reconstruction
uniform mat4 invView;     // eye space -> world space
uniform mat4 lightVP;     // world -> light clip space

// Real GL depth path: when useRealDepth > 0.5, reconstruct each pixel from the
// actual depth buffer (which includes depth-stamped props and furniture) via the
// inverse projection, instead of the background-only mask - so the shadow lands on
// props at their true position rather than the wall behind them.
uniform sampler2D sceneDepthTex;
uniform mat4 invProj;     // clip space -> eye space
uniform float useRealDepth;

uniform sampler2D shadowTex;  // depth-in-colour shadow map
uniform float shadowAlpha;
uniform float shadowBias;
uniform vec2 shadowTexel;
uniform float shadowSoftness;
uniform float bgDebug;   // 0 off; 1 mask; 2 eye.xy; 3 world.xy; 4 light-space UV
uniform vec3 actorWorld; // April's feet in world space, for the spatial falloff
uniform float shadowReach; // max horizontal shadow extent (world units)

float decodeMask(vec2 uv) {
	vec4 d = texture(bgDepthTex, vec2(uv.x, 1.0 - uv.y)); // mask is top-origin
	return (d.r * 255.0 * 256.0 + d.g * 255.0) / 65535.0;
}

float occluderDepth(vec2 uv) {
	vec3 c = texture(shadowTex, uv).rgb;   // 24-bit depth packed in RGB
	return dot(c, vec3(1.0, 1.0 / 255.0, 1.0 / 65025.0));
}

void main() {
	vec2 ndc = vUV * 2.0 - 1.0;
	float norm = decodeMask(vUV);            // kept for the mask fallback + debug 1

	vec3 eyePos;
	if (useRealDepth > 0.5) {
		// Reconstruct from the real depth buffer: NDC.xy from the screen, NDC.z
		// from the sampled window depth, un-projected to eye space. Includes props.
		float d = texture(sceneDepthTex, vUV).r;
		vec4 clip = vec4(ndc, d * 2.0 - 1.0, 1.0);
		vec4 eh = invProj * clip;
		eyePos = eh.xyz / eh.w;
	} else {
		// Background-mask path: eye z from the calibrated mask, x/y from NDC.
		float eyeZ = mix(zMin, zMax, norm);
		eyePos.z = -eyeZ;
		eyePos.x = ndc.x * eyeZ / projScale.x;
		eyePos.y = ndc.y * eyeZ / projScale.y;
	}

	vec4 world = invView * vec4(eyePos, 1.0);
	vec4 lc = lightVP * world;
	vec3 lndc = lc.xyz / lc.w;
	vec2 suv = lndc.xy * 0.5 + 0.5;

	// Diagnostic visualizations (opaque, fill the whole screen):
	//   1 = mask depth (grey), 2 = reconstructed eye x/y, 3 = world x/y, 4 = the
	//   light-space UV the pixel maps to (should be smooth around the caster).
	if (bgDebug > 0.5) {
		if (bgDebug < 1.5) {
			outColor = vec4(vec3(norm), 1.0);
		} else if (bgDebug < 2.5) {
			outColor = vec4(fract(eyePos.x * 0.01), fract(eyePos.y * 0.01), 0.0, 1.0);
		} else if (bgDebug < 3.5) {
			outColor = vec4(fract(world.x * 0.001), fract(world.y * 0.001), fract(world.z * 0.001), 1.0);
		} else {
			outColor = vec4(clamp(suv, 0.0, 1.0), 0.0, 1.0);
		}
		return;
	}

	// Outside the shadow map (light frustum) => not shadowed.
	if (suv.x < 0.01 || suv.x > 0.99 || suv.y < 0.01 || suv.y > 0.99) {
		discard;
	}
	float fragDepth = lndc.z * 0.5 + 0.5;

	// Contact hardening (PCSS-lite): crisp near the caster, softer with distance.
	vec2 searchStep = shadowTexel * shadowSoftness;
	float blockerSum = 0.0;
	float blockerCount = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			float od = occluderDepth(suv + vec2(float(x), float(y)) * searchStep);
			if (fragDepth - shadowBias > od) {
				blockerSum += od;
				blockerCount += 1.0;
			}
		}
	}
	if (blockerCount < 0.5) {
		discard;
	}
	float gap = max(fragDepth - blockerSum / blockerCount, 0.0);
	float hard = clamp(gap * 8.0, 0.0, 1.0);
	float penumbra = mix(shadowSoftness * 0.6, shadowSoftness * 1.9, hard);

	vec2 stepv = shadowTexel * penumbra;
	float sh = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			float od = occluderDepth(suv + vec2(float(x), float(y)) * stepv);
			sh += (fragDepth - shadowBias > od) ? 1.0 : 0.0;
		}
	}
	sh /= 25.0;

	if (sh <= 0.0) {
		discard;
	}

	// Spatial falloff: the screen-space drape would otherwise darken ANY pixel
	// that lands in the light frustum, including far walls and surfaces BELOW the
	// floor that happen to line up behind April. Confine it to her vicinity.
	//  - horizontal: fade past the shadow's real reach from her feet.
	//  - vertical: fade out surfaces well below the floor (under-floor leaks); the
	//    shadow should climb from the floor upward, not spill beneath it.
	float horizDist = length(world.xy - actorWorld.xy);
	float horizFade = 1.0 - smoothstep(shadowReach * 0.75, shadowReach * 1.2, horizDist);
	float vFade = smoothstep(actorWorld.z - 150.0, actorWorld.z - 30.0, world.z);
	sh *= horizFade * vFade;

	if (sh <= 0.0) {
		discard;
	}
	outColor = vec4(0.0, 0.0, 0.0, shadowAlpha * sh);
}
